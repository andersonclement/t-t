rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. GLOBAL SAFETY NET
    match /{document=**} {
      allow read, write: if false;
    }

    // --- SHARED HELPERS ---
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return isSignedIn(); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // Role lookups
    function getUserData() { 
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; 
    }
    function isPharmacist() { 
      return isSignedIn() && getUserData().role == 'pharmacist'; 
    }
    function isDoctor() {
      let role = getUserData().role;
      return isSignedIn() && (role == 'hospital' || role == 'practitioner');
    }

    // --- VALIDATION BLUEPRINTS ---
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'role', 'createdAt', 'updatedAt'])
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() <= 100
        && data.email is string && data.email.size() <= 100
        && data.role in ['patient', 'pharmacist', 'hospital']
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['patientId', 'status', 'items', 'total', 'createdAt', 'updatedAt', 'mode'])
        && data.patientId == request.auth.uid
        && data.status in ['pending_validation', 'validated', 'preparing', 'out_for_delivery', 'delivered', 'rejected']
        && data.total is number 
        && data.mode in ['delivery', 'pickup']
        && data.items is list
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    // --- COLLECTION RULES ---

    // USERS: Split collection PII isolation
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isPharmacist());
      allow list: if isPharmacist(); // Only pharmacists can list users for directory
      allow create: if isSignedIn() && request.auth.uid == userId 
        && isValidUser(incoming())
        && (incoming().role == 'patient' || incoming().role == 'pharmacist'); 
      allow update: if isSignedIn() && request.auth.uid == userId 
        && isValidUser(incoming())
        && isEmailVerified() // Require verified email for profile updates
        && incoming().email == existing().email // Email is immutable via client
        && incoming().role == existing().role; // Role is immutable via client
    }

    // MEDICATIONS: Public read, restricted write
    match /medications/{medicationId} {
      allow read: if true;
      allow write: if isPharmacist() && isEmailVerified() && isValidId(medicationId);
    }

    // ORDERS: Relational sync & access
    match /orders/{orderId} {
      allow create: if isEmailVerified() && isValidOrder(incoming());
      allow read: if isSignedIn() && (existing().patientId == request.auth.uid || isPharmacist());
      allow update: if isEmailVerified() && (
        // Action: Cancel (Patient)
        (existing().patientId == request.auth.uid && incoming().status == 'cancelled' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
        // Action: Status Update (Pharmacist)
        (isPharmacist() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
      );
    }

    // PRESCRIPTIONS: Sensitive data
    match /prescriptions/{prescriptionId} {
      allow create: if isEmailVerified() && incoming().patientId == request.auth.uid;
      allow get: if isSignedIn() && (existing().patientId == request.auth.uid || isPharmacist());
      allow list: if isSignedIn() && resource.data.patientId == request.auth.uid;
    }

    // HOSPITALS & HEALTH SPOTS
    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if isDoctor() && isValidId(hospitalId);
    }
  }
}
